# LLM provider: openai | anthropic | ollama
LLM_PROVIDER=openai
# Leave empty to use the provider's default model:
#   openai -> gpt-4o-mini, anthropic -> claude-haiku-5-5, ollama -> llama3.2
# Set it to override (e.g. LLM_MODEL=claude-opus-5-5); a set value always wins.
LLM_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Embeddings (local, no key needed)
EMBEDDING_MODEL=intfloat/multilingual-e5-small
CHROMA_PATH=./data/chroma

# Optional tracing
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Evals
RUN_LIVE_EVALS=0
